def handle_click(pos):

    global selected_square
    global possible_moves
    global en_passant_target
    global current_turn

    global white_king_moved
    global black_king_moved
    global white_left_rook_moved
    global white_right_rook_moved
    global black_left_rook_moved
    global black_right_rook_moved

    global promotion_pending
    global promotion_square
    global promotion_is_white
    global game_over

    if game_over:
        return
    mouse_x, mouse_y = pos

    # Click outside board
    if not (
        BOARD_X <= mouse_x < BOARD_X + BOARD_SIZE
        and BOARD_Y <= mouse_y < BOARD_Y + BOARD_SIZE
    ):
        selected_square = None
        possible_moves = []
        return

    col = (mouse_x - BOARD_X) // SQUARE_SIZE
    row = (mouse_y - BOARD_Y) // SQUARE_SIZE

    clicked_square = (row, col)

    # --------------------------------
    # MOVE SELECTED PIECE
    # --------------------------------
    if selected_square is not None and clicked_square in possible_moves:

        old_row, old_col = selected_square
        moving_piece = pieces[old_row][old_col]

        old_en_passant_target = en_passant_target
        en_passant_target = None

        # -----------------------------
        # CASTLING
        # -----------------------------

        # White kingside
        if (
            moving_piece == "♔"
            and (old_row, old_col) == (7, 4)
            and (row, col) == (7, 6)
        ):
            pieces[7][6] = "♔"
            pieces[7][5] = "♖"
            pieces[7][4] = ""
            pieces[7][7] = ""

            white_king_moved = True
            white_right_rook_moved = True

        # White queenside
        elif (
            moving_piece == "♔"
            and (old_row, old_col) == (7, 4)
            and (row, col) == (7, 2)
        ):
            pieces[7][2] = "♔"
            pieces[7][3] = "♖"
            pieces[7][4] = ""
            pieces[7][0] = ""

            white_king_moved = True
            white_left_rook_moved = True

        # Black kingside
        elif (
            moving_piece == "♚"
            and (old_row, old_col) == (0, 4)
            and (row, col) == (0, 6)
        ):
            pieces[0][6] = "♚"
            pieces[0][5] = "♜"
            pieces[0][4] = ""
            pieces[0][7] = ""

            black_king_moved = True
            black_right_rook_moved = True

        # Black queenside
        elif (
            moving_piece == "♚"
            and (old_row, old_col) == (0, 4)
            and (row, col) == (0, 2)
        ):
            pieces[0][2] = "♚"
            pieces[0][3] = "♜"
            pieces[0][4] = ""
            pieces[0][0] = ""

            black_king_moved = True
            black_left_rook_moved = True

        # -----------------------------
        # NORMAL MOVE
        # -----------------------------
        else:

            # EN PASSANT CAPTURE
            if (
                moving_piece in "♙♟"
                and old_en_passant_target == (row, col)
                and pieces[row][col] == ""
                and old_col != col
            ):
                if moving_piece == "♙":
                    pieces[row + 1][col] = ""
                else:
                    pieces[row - 1][col] = ""

            # Move/capture
            pieces[row][col] = moving_piece
            pieces[old_row][old_col] = ""

            # CREATE EN PASSANT TARGET
            if moving_piece == "♙" and old_row == 6 and row == 4:
                en_passant_target = (5, col)

            elif moving_piece == "♟" and old_row == 1 and row == 3:
                en_passant_target = (2, col)

            # PAWN PROMOTION
            if moving_piece == "♙" and row == 0:
                promotion_pending = True
                promotion_square = (row, col)
                promotion_is_white = True

            elif moving_piece == "♟" and row == 7:
                promotion_pending = True
                promotion_square = (row, col)
                promotion_is_white = False

            # RECORD KING / ROOK MOVEMENT
            if moving_piece == "♔":
                white_king_moved = True

            elif moving_piece == "♚":
                black_king_moved = True

            elif moving_piece == "♖":
                if old_row == 7 and old_col == 0:
                    white_left_rook_moved = True

                elif old_row == 7 and old_col == 7:
                    white_right_rook_moved = True

            elif moving_piece == "♜":
                if old_row == 0 and old_col == 0:
                    black_left_rook_moved = True

                elif old_row == 0 and old_col == 7:
                    black_right_rook_moved = True

        # --------------------------------
        # SWITCH TURN
        # --------------------------------

        # Don't switch yet if promotion menu is open
        if not promotion_pending:

            if current_turn == "white":
                current_turn = "black"
            else:
                current_turn = "white"

            update_game_state()

        selected_square = None
        possible_moves = []

        return

    # --------------------------------
    # SELECT PIECE
    # --------------------------------
    if pieces[row][col] != "":

        clicked_piece = pieces[row][col]

        white_pieces = "♙♖♘♗♕♔"
        black_pieces = "♟♜♞♝♛♚"

        # Can't select opponent's piece
        if current_turn == "white" and clicked_piece not in white_pieces:
            return

        if current_turn == "black" and clicked_piece not in black_pieces:
            return

        # Clicking same selected piece deselects it
        if selected_square == clicked_square:

            selected_square = None
            possible_moves = []

        else:

            selected_square = clicked_square
            possible_moves = get_possible_moves(row, col)

    # --------------------------------
    # CLICK EMPTY INVALID SQUARE
    # --------------------------------
    else:

        selected_square = None
        possible_moves = []
def get_sliding_moves(row, col, directions, is_white):

    moves = []

    white_pieces = "♙♖♘♗♕♔"
    black_pieces = "♟♜♞♝♛♚"

    own_pieces = white_pieces if is_white else black_pieces
    enemy_pieces = black_pieces if is_white else white_pieces

    for row_change, col_change in directions:

        new_row = row + row_change
        new_col = col + col_change

        while 0 <= new_row < 8 and 0 <= new_col < 8:

            target = pieces[new_row][new_col]

            # Empty square
            if target == "":
                moves.append((new_row, new_col))

            # Enemy piece: can capture, then stop
            elif target in enemy_pieces:
                moves.append((new_row, new_col))
                break

            # Own piece: blocked
            elif target in own_pieces:
                break

            new_row += row_change
            new_col += col_change

    return moves
def find_king(board, is_white):

    king = "♔" if is_white else "♚"

    for row in range(8):
        for col in range(8):

            if board[row][col] == king:
                return (row, col)

    return None
def is_square_attacked(board, row, col, by_white):

    # --------------------------------
    # PAWNS
    # --------------------------------

    if by_white:
        pawn = "♙"

        pawn_positions = [
            (row + 1, col - 1),
            (row + 1, col + 1)
        ]

    else:
        pawn = "♟"

        pawn_positions = [
            (row - 1, col - 1),
            (row - 1, col + 1)
        ]

    for r, c in pawn_positions:

        if 0 <= r < 8 and 0 <= c < 8:

            if board[r][c] == pawn:
                return True

    # --------------------------------
    # KNIGHTS
    # --------------------------------

    knight = "♘" if by_white else "♞"

    knight_moves = [
        (-2, -1),
        (-2, 1),
        (-1, -2),
        (-1, 2),
        (1, -2),
        (1, 2),
        (2, -1),
        (2, 1)
    ]

    for dr, dc in knight_moves:

        r = row + dr
        c = col + dc

        if 0 <= r < 8 and 0 <= c < 8:

            if board[r][c] == knight:
                return True

    # --------------------------------
    # ROOK / QUEEN DIRECTIONS
    # --------------------------------

    rook = "♖" if by_white else "♜"
    queen = "♕" if by_white else "♛"

    straight_directions = [
        (-1, 0),
        (1, 0),
        (0, -1),
        (0, 1)
    ]

    for dr, dc in straight_directions:

        r = row + dr
        c = col + dc

        while 0 <= r < 8 and 0 <= c < 8:

            target = board[r][c]

            if target != "":

                if target == rook or target == queen:
                    return True

                break

            r += dr
            c += dc

    # --------------------------------
    # BISHOP / QUEEN DIRECTIONS
    # --------------------------------

    bishop = "♗" if by_white else "♝"

    diagonal_directions = [
        (-1, -1),
        (-1, 1),
        (1, -1),
        (1, 1)
    ]

    for dr, dc in diagonal_directions:

        r = row + dr
        c = col + dc

        while 0 <= r < 8 and 0 <= c < 8:

            target = board[r][c]

            if target != "":

                if target == bishop or target == queen:
                    return True

                break

            r += dr
            c += dc

    # --------------------------------
    # KING
    # --------------------------------

    king = "♔" if by_white else "♚"

    for dr in [-1, 0, 1]:
        for dc in [-1, 0, 1]:

            if dr == 0 and dc == 0:
                continue

            r = row + dr
            c = col + dc

            if 0 <= r < 8 and 0 <= c < 8:

                if board[r][c] == king:
                    return True

    return False
def is_in_check(board, is_white):

    king_square = find_king(board, is_white)

    if king_square is None:
        return False

    king_row, king_col = king_square

    return is_square_attacked(
        board,
        king_row,
        king_col,
        not is_white
    )
