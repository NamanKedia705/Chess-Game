# Draw functions
def draw_board():

    for row in range(8):
        for col in range(8):

            # Alternate colours
            if (row + col) % 2 == 0:
                colour = LIGHT_SQUARE
            else:
                colour = DARK_SQUARE

            x = BOARD_X + col * SQUARE_SIZE
            y = BOARD_Y + row * SQUARE_SIZE

            pygame.draw.rect(
                screen,
                colour,
                (x, y, SQUARE_SIZE, SQUARE_SIZE)
            )
def draw_pieces():

    for row in range(8):
        for col in range(8):

            piece = pieces[row][col]

            if piece == "":
                continue

            x = (
                BOARD_X
                + col * SQUARE_SIZE
                + SQUARE_SIZE // 2
            )

            y = (
                BOARD_Y
                + row * SQUARE_SIZE
                + SQUARE_SIZE // 2
            )

            # WHITE PIECES
            if piece in "♙♖♘♗♕♔":

                main_colour = (245, 245, 245)
                outline_colour = (30, 30, 30)

                # Draw dark outline
                for offset_x, offset_y in [
                    (-2, 0),
                    (2, 0),
                    (0, -2),
                    (0, 2)
                ]:

                    outline = piece_font.render(
                        piece,
                        True,
                        outline_colour
                    )

                    outline_rect = outline.get_rect(
                        center=(x + offset_x, y + offset_y)
                    )

                    screen.blit(outline, outline_rect)

                # Draw white piece
                text = piece_font.render(
                    piece,
                    True,
                    main_colour
                )

            # BLACK PIECES — no outline
            else:

                text = piece_font.render(
                    piece,
                    True,
                    (25, 25, 25)
                )

            text_rect = text.get_rect(
                center=(x, y)
            )

            screen.blit(text, text_rect)
